{
  "name": "palette-extractor",
  "description": "Extract a color palette from any image, entirely in the browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "npm run build -w @samalbanese/median-cut",
    "preview": "vite preview",
    "prepare": "npm run build -w @samalbanese/median-cut",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@samalbanese/median-cut": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
